    # 2. Keep your database name
    DB_NAME=StudentCardDB

    # 3. Docker SQL images use the 'sa' (System Admin) user by default
    DB_USER=sa

    # 4. This MUST match the MSSQL_SA_PASSWORD you wrote in docker-compose.yml
